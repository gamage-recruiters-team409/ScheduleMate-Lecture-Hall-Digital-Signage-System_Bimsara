meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@sparkline.ac",
    "password": "StrongAdminPassword123!"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("token", res.body.accessToken);
  }
}
