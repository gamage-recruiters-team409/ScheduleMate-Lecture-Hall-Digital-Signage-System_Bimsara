# Server Configuration
PORT=3001
NODE_ENV=development
APP_TIMEZONE=Asia/Colombo
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# For local development with Docker:
DATABASE_URL="postgresql://schedulemate:schedulemate@localhost:5432/schedulemate?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_32_chars
JWT_EXPIRATION=8h

# Seed Admin User Setup
# Note: Seed script will REJECT placeholder passwords or weak passwords (< 8 chars)
SEED_ADMIN_EMAIL=admin@sparkline.ac
SEED_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_LOCAL_PASSWORD
SEED_ADMIN_NAME="Sparkline Admin"
